# ── Database (Neon serverless PostgreSQL) ─────────────────────────────
# Neon dashboard → Connection Details → pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# ── Authentication (Better Auth) ──────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public URL of the web app (the browser talks to Next.js, which proxies /api/* here)
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Model training (optional overrides) ───────────────────────────────
# PYTHON_BIN=python
# MODEL_STORE_DIR=./model_store
# INITIAL_MODEL_VERSION=rf-v1
# EXTERNAL_VALIDATION_DATA=../model_training/Heart_Disease x2.xlsx

# ── Email alerts (Resend) ─────────────────────────────────────────────
# API key: https://resend.com/api-keys · sender must use a domain verified in Resend
RESEND_API_KEY=
RESEND_EMAIL_FROM="St. Mary's CVD Alerts <alerts@your-verified-domain.com>"
# assessor_and_admins (default) | all_staff
# ALERT_RECIPIENTS=assessor_and_admins
# Emails pass through a third party – keep the hospital number masked unless approved
# ALERT_SHOW_HOSPITAL_NUMBER=false
# Background jobs (node-cron syntax). DIGEST_CRON=off disables the morning summary.
# OUTBOX_CRON=* * * * *
# DIGEST_CRON=0 7 * * *
# CRON_TIMEZONE=Africa/Accra

# ── First administrator (used by: npm run seed:admin) ─────────────────
# SEED_ADMIN_EMAIL=admin@stmarys.local
# SEED_ADMIN_NAME=System Administrator

